{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["powershell.exe", "taskkill.exe"],
  "entry": [
    "electron.vite.config.ts",
    "src/platform/electron-main/main.ts",
    "src/platform/electron-main/terminal-runtime-provider.ts",
    "src/platform/electron-preload/preload.ts",
    "tests/**/*.spec.tsx"
  ],
  "project": [
    "*.config.js",
    "*.config.ts",
    "scripts/**/*.mjs",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
