{
  "name": "cleancode",
  "version": "0.1.0",
  "private": true,
  "description": "AI-driven block-based desktop workbench.",
  "type": "module",
  "main": "out/main/main.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "check:deps": "node scripts/check-exact-deps.mjs",
    "depcruise": "depcruise src tests --config .dependency-cruiser.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{js,cjs,mjs,ts,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{js,cjs,mjs,ts,json,html}\"",
    "knip": "knip",
    "lint": "eslint . --max-warnings=0",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "pre-commit": "pnpm check:deps && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm depcruise && pnpm knip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.11.1",
    "lucide-react": "1.23.0",
    "node-pty": "1.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "dependency-cruiser": "17.4.3",
    "electron": "43.0.0",
    "electron-vite": "5.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "knip": "6.24.0",
    "lint-staged": "17.0.8",
    "playwright": "1.61.1",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "7.3.6",
    "vitest": "4.1.9"
  }
}
