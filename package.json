{
  "name": "cleancode",
  "productName": "CleanCode",
  "version": "0.1.2",
  "private": true,
  "author": "chen-985211",
  "homepage": "https://github.com/chen-985211/cleancode",
  "repository": {
    "type": "git",
    "url": "https://github.com/chen-985211/cleancode.git"
  },
  "license": "MIT",
  "description": "A local-first executable development workspace for humans and coding agents.",
  "type": "module",
  "main": "out/main/main.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "package": "pnpm build && pnpm prepare:packaging && electron-builder --dir --publish never",
    "dist": "pnpm build && pnpm prepare:packaging && electron-builder --publish never",
    "dist:mac": "pnpm build && pnpm prepare:packaging && electron-builder --mac --publish never",
    "dist:win": "pnpm build && pnpm prepare:packaging && electron-builder --win --publish never",
    "dist:linux": "pnpm build && pnpm prepare:packaging && electron-builder --linux --publish never",
    "prepare:packaging": "node scripts/prepare-packaging.mjs",
    "check:agent-provider-boundary": "node scripts/check-agent-provider-boundary.mjs",
    "check:deps": "node scripts/check-exact-deps.mjs",
    "check:docs": "node scripts/check-docs.mjs && node scripts/generate-agent-readme-assets.mjs --check",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:logging": "node scripts/check-logging.mjs",
    "check:max-lines": "node scripts/check-max-lines.mjs --all",
    "check:portable-paths": "node scripts/check-portable-paths.mjs",
    "check:quality": "pnpm check:deps && pnpm check:docs && pnpm check:max-lines && pnpm check:logging && pnpm check:agent-provider-boundary && pnpm check:theme && pnpm check:i18n && pnpm check:portable-paths && pnpm format:check && pnpm lint && pnpm typecheck && pnpm depcruise && pnpm knip",
    "check:theme": "node scripts/check-theme.mjs",
    "depcruise": "depcruise src tests --config .dependency-cruiser.cjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{js,cjs,mjs,ts,json,html}\" \"{README,AGENTS}.md\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.{js,cjs,mjs,ts,json,html}\" \"{README,AGENTS}.md\" \"docs/**/*.md\"",
    "generate:agent-readme-assets": "node scripts/generate-agent-readme-assets.mjs",
    "knip": "knip",
    "lint": "eslint . --max-warnings=0",
    "lint:staged": "lint-staged",
    "prepare": "husky",
    "pre-commit": "pnpm check:quality && pnpm test:full",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:core && pnpm test:e2e:smoke",
    "test:core": "pnpm test:unit && pnpm test:integration && pnpm test:contract",
    "test:core:ci": "pnpm test:unit && pnpm test:integration:ci && pnpm test:contract",
    "test:full": "pnpm test:core && pnpm test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:integration:ci": "vitest run tests/integration --no-file-parallelism",
    "test:contract": "vitest run tests/contract --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts --no-file-parallelism",
    "test:e2e:smoke": "vitest run --config vitest.e2e.config.ts --no-file-parallelism --tagsFilter smoke",
    "test:e2e:visible": "vitest run --config vitest.e2e.visible.config.ts --no-file-parallelism",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-tooltip": "1.2.12",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "12.11.1",
    "lucide-react": "1.23.0",
    "node-pty": "1.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "dependency-cruiser": "17.4.3",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "knip": "6.24.0",
    "lint-staged": "17.0.8",
    "playwright": "1.61.1",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "7.3.6",
    "vitest": "4.1.9"
  }
}
